<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
        <style>
        
    body {
        margin: 0;
        padding: 0;
        font-family: sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: #f2f2f2;
    }

    table {
        width: 90vw;
        max-width: 400px;
        height: auto;
        border-collapse: collapse;
        background-color: #fff;
        box-shadow: 0 0 10px rgba(0,0,0,0.2);
    }

    input[type="text"] {
        width: 100%;
        height: 60px;
        font-size: 24px;
        text-align: right;
        padding: 10px;
        box-sizing: border-box;
        border: none;
        background-color: #f9f9f9;
    }

    input[type="button"] {
        width: 100%;
        height: 60px;
        background-color: lightslategray;
        color: white;
        font-size: 1.5em;
        border: none;
        transition: background-color 0.3s, transform 0.1s;
        cursor: pointer;
    }

    input[type="button"]:hover {
        background-color: darkslategray;
    }

    input[type="button"]:active {
        transform: scale(0.95);
    }

    #cc {
        background-color: orangered;
    }

    #cc:hover {
        background-color: darkred;
    }

    #eq {
        background-color: green;
    }

    #eq:hover {
        background-color: darkgreen;
    }

    @media screen and (max-width: 600px) {
        input[type="button"],
        input[type="text"] {
            height: 50px;
            font-size: 1.2em;
        }
    }
        </style>
<body>
    <table border="">
        <tr>
            <td colspan="3"><input type="text" name="" id="res" ></td>
            <td><input id="cc" type="button" value="c"></td>
        </tr>
        <tr>
            
            <td><input type="button" value="Ac"></td>
            <td><input type="button" value="+" onclick="val('+')"></td>
            <td><input type="button" value="-" onclick="val('-')"></td>
            <td><input type="button" value="%" onclick="val('%')"></td>
        </tr>
        <tr>
            
            <td><input type="button" value="9" onclick="val(9)"></td>
            <td><input type="button" value="8" onclick="val(8)"></td>
            <td><input type="button" value="7" onclick="val(7)"></td>
            <td><input type="button" value="*" onclick="val('*')"></td>
        </tr>
        <tr>
            
            <td><input type="button" value="6" onclick="val(6)"></td>
            <td><input type="button" value="5" onclick="val(5)"></td>
            <td><input type="button" value="4" onclick="val(4)"></td>
            <td><input type="button" value="/" onclick="val('/')"></td>
        </tr>
        <tr>
            
            <td><input type="button" value="3" onclick="val(3)"></td>
            <td><input type="button" value="2" onclick="val(2)"></td>
            <td><input type="button" value="1" onclick="val(1)"></td>
            <td><input type="button" value="." onclick="val('.')"></td>
        </tr>
        <tr>
            
            <td><input type="button" value="00" onclick="val('00')"></td>
            <td><input type="button" value="0" onclick="val(0)"></td>
            <td><input id="eq" type="button" value="=" onclick="Result()"></td>
            <td><input type="button" value="X" id="del"></td>
        </tr>
    </table>
<script>
    rbox=document.getElementById('res')
cbtn=document.getElementById('cc')
cbtn.addEventListener('click',()=>{
    document.getElementById('res').value=""
})
function val(n)
{
    rbox.value=rbox.value+n
}

function Result(r)
{
    var r=eval(rbox.value)
    rbox.value=r
}

dbtn=document.getElementById('del')
   
dbtn.addEventListener('click',()=>{
    
    rbox.value = rbox.value.slice(0, -2)

})
</script>
</body>
</html>
