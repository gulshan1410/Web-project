<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>TimerProject</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      font-family: sans-serif;
      background-color: #f4f4f4;
      padding: 10px;
    }

    .con {
      width: 100%;
      max-width: 350px;
      border: 8px inset darkgray;
      text-align: center;
      padding: 20px;
      background: white;
      border-radius: 10px;
    }

    .con h1 {
      font-family: Arial, sans-serif;
      letter-spacing: 6px;
      text-shadow: 2px 2px 5px red;
      margin-bottom: 15px;
      font-size: 1.5rem;
    }

    .timer {
      font-size: 2rem;
      font-weight: bold;
    }

    .sep {
      font-size: 2rem;
      font-weight: bold;
      color: red;
    }

    #hh, #mm, #ss, #mss {
      font-size: 0.8rem;
    }

    .btn {
      width: 80px;
      height: 35px;
      margin: 10px 5px 0;
      border-radius: 8px;
      font-weight: bold;
      border: 2px outset;
      font-size: 1rem;
      cursor: pointer;
    }

    #btn1 { background-color: green; color: white; }
    #btn2 { background-color: red; color: white; }
    #btn3 { background-color: blue; color: white; }

    @media (max-width: 400px) {
      .con h1 {
        font-size: 1.2rem;
      }

      .timer, .sep {
        font-size: 1.5rem;
      }

      .btn {
        width: 70px;
        height: 30px;
        font-size: 0.9rem;
      }
    }
  </style>
</head>
<body>
  <div class="con">
    <h1>Stop Watch</h1>
    <span class="timer" id="h">00</span><span class="timer" id="hh">H</span>
    <span class="sep">:</span>
    <span class="timer" id="m">00</span><span class="timer" id="mm">M</span>
    <span class="sep">:</span>
    <span class="timer" id="s">00</span><span class="timer" id="ss">S</span>
    <span class="sep">:</span>
    <span class="timer" id="ms">00</span><span class="timer" id="mss">Ms</span>
    <br />
    <button class="btn" id="btn1" onclick="start()">Start</button>
    <button class="btn" id="btn2" onclick="stop()">Stop</button>
    <button class="btn" id="btn3" onclick="reset()">Reset</button>
  </div>

  <script>
    let h = 0, m = 0, s = 0, ms = 0;
    let timer = false;

    function start() {
      if (!timer) {
        timer = true;
        stopwatch();
      }
    }

    function stop() {
      timer = false;
    }

    function reset() {
      timer = false;
      h = m = s = ms = 0;
      updateDisplay();
    }

    function stopwatch() {
      if (!timer) return;
      ms++;
      if (ms === 100) { ms = 0; s++; }
      if (s === 60) { s = 0; m++; }
      if (m === 60) { m = 0; h++; }

      updateDisplay();
      setTimeout(stopwatch, 10);
    }

    function updateDisplay() {
      document.getElementById("ms").textContent = ms.toString().padStart(2, "0");
      document.getElementById("s").textContent = s.toString().padStart(2, "0");
      document.getElementById("m").textContent = m.toString().padStart(2, "0");
      document.getElementById("h").textContent = h.toString().padStart(2, "0");
    }
  </script>
</body>
</html>
